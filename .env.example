# Google Maps Platform key for address autocomplete on /apply.
# Never commit the real value. Copy to `.env.local` (gitignored).
#
# The key is inlined into the client bundle at build time, so it MUST be
# HTTP-referrer restricted to your development, staging, and production URLs.
# Run `scripts/enable-google-places.sh` for the gcloud + Vercel commands.
VITE_GOOGLE_MAPS_API_KEY=
