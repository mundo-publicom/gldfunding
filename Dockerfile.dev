# Development image: runs the Vite dev server with HMR.
# The source tree is bind-mounted by compose, so this image only needs to own
# node_modules (built for Linux — the host's macOS binaries must never leak in).
FROM node:22-alpine

# Pin pnpm to the version the lockfile was written with.
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

WORKDIR /app

# `postinstall` runs scripts/patch-manifests.mjs, so scripts/ has to be present
# before the install layer — otherwise the install fails on a missing file.
COPY package.json pnpm-lock.yaml ./
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile

# Only a fallback for `docker build` without compose; the bind mount shadows it.
COPY . .

EXPOSE 5173

CMD ["pnpm", "dev"]
