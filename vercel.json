{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/mca",
      "destination": "/funding/merchant-cash-advance",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/resources/glossary",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/funding/cost",
      "destination": "/funding/merchant-cash-advance",
      "permanent": true
    },
    {
      "source": "/funding/qualify",
      "destination": "/apply",
      "permanent": true
    },
    {
      "source": "/funding",
      "destination": "/funding/merchant-cash-advance",
      "permanent": true
    },
    {
      "source": "/merchant-cash-advance",
      "destination": "/funding/merchant-cash-advance",
      "permanent": true
    },
    {
      "source": "/merchant-cash-advances",
      "destination": "/funding/merchant-cash-advance",
      "permanent": true
    },
    {
      "source": "/what-is-a-merchant-cash-advance",
      "destination": "/funding/merchant-cash-advance",
      "permanent": true
    },
    {
      "source": "/how-it-works",
      "destination": "/funding/how-it-works",
      "permanent": true
    },
    {
      "source": "/process",
      "destination": "/funding/how-it-works",
      "permanent": true
    },
    {
      "source": "/mca-vs-business-loan",
      "destination": "/funding/mca-vs-business-loan",
      "permanent": true
    },
    {
      "source": "/mca-vs-loan",
      "destination": "/funding/mca-vs-business-loan",
      "permanent": true
    },
    {
      "source": "/funding/mca-vs-loan",
      "destination": "/funding/mca-vs-business-loan",
      "permanent": true
    },
    {
      "source": "/eligibility",
      "destination": "/apply",
      "permanent": true
    },
    {
      "source": "/get-started",
      "destination": "/apply",
      "permanent": true
    },
    {
      "source": "/apply-now",
      "destination": "/apply",
      "permanent": true
